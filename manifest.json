{
  "manifest_version": 3,
  "name": "Widgetize",
  "description": "Mensagens rápidas para o SAC Messenger.",
  "version": "3.6",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "*://*.ascbrazil.com.br/*",
    "*://*.blip.ai/*"
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Abrir Mensagens",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.ascbrazil.com.br/*",
        "*://*.blip.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
